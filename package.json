{
  "name": "munshi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "redproof": "pnpm --filter @munshi/db run redproof"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
