{
  "name": "munshi",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "contracts": "node packages/contracts/src/build.ts",
    "sdk:pack": "node packages/sdk/scripts/pack.ts",
    "kit": "node apps/web/scripts/kit.ts",
    "dev": "node db/src/dev.ts",
    "teammate": "pnpm --filter @munshi/teammate run start",
    "teammate:register": "pnpm --filter @munshi/teammate run register",
    "identity:reset": "node db/src/identity-reset.ts",
    "dev:ticker": "node scripts/dev-ticker.ts",
    "platform:operator": "node db/src/platform-operator.ts",
    "platform:identity": "node db/src/platform-identity.ts",
    "platform:list": "node db/src/platform-cli.ts list",
    "platform:propose": "node db/src/platform-cli.ts propose",
    "platform:approve": "node db/src/platform-cli.ts approve",
    "platform:reject": "node db/src/platform-cli.ts reject",
    "db:bootstrap": "pnpm --filter @munshi/db run schema:bootstrap",
    "db:build": "pnpm --filter @munshi/db run schema:build",
    "db:reset": "pnpm --filter @munshi/db run schema:reset",
    "redproof": "pnpm --filter @munshi/db run redproof",
    "reseed": "pnpm --filter @munshi/db run reseed",
    "apimatic:validate": "node apimatic/run.ts validate",
    "apimatic:portal": "node apimatic/run.ts portal",
    "apimatic:sdk": "node apimatic/run.ts sdk",
    "postman:build": "node integrations/postman/build.ts",
    "postman:check": "node --test integrations/postman/coverage.test.ts",
    "postman:test": "node integrations/postman/run.ts",
    "zapier:test": "npm --prefix integrations/zapier test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "catalog:",
    "newman": "6.2.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
