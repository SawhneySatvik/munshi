{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/web...",
      "buildCommand": "pnpm build"
    },
    "elite": {
      "root": "apps/elite",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/elite...",
      "buildCommand": "pnpm build",
      "bindings": [{ "type": "service", "service": "web", "format": "url", "env": "WEB_URL" }]
    },
    "prabhave": {
      "root": "apps/prabhave",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/prabhave...",
      "buildCommand": "pnpm build",
      "bindings": [{ "type": "service", "service": "web", "format": "url", "env": "WEB_URL" }]
    }
  },
  "rewrites": [
    { "source": "/s/elite", "destination": { "service": "elite" } },
    { "source": "/s/elite/(.*)", "destination": { "service": "elite" } },
    { "source": "/s/prabhave", "destination": { "service": "prabhave" } },
    { "source": "/s/prabhave/(.*)", "destination": { "service": "prabhave" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/internal/tick", "schedule": "41 0 * * *" }]
}
