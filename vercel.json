{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/web...",
      "buildCommand": "pnpm build"
    },
    "elite": {
      "root": "apps/sites",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/sites...",
      "buildCommand": "if [ -d .next ]; then mv .next .next-web; fi; MUNSHI_SITE=elite MUNSHI_SITES_BASE_PATH=/s/elite NEXT_PUBLIC_MUNSHI_SITES_BASE_PATH=/s/elite MUNSHI_SITES_DIST=.next-elite pnpm build && mv .next-elite .next"
    },
    "prabhave": {
      "root": "apps/sites",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @munshi/sites...",
      "buildCommand": "if [ -d .next ]; then mv .next .next-elite; fi; MUNSHI_SITE=prabhave MUNSHI_SITES_BASE_PATH=/s/prabhave NEXT_PUBLIC_MUNSHI_SITES_BASE_PATH=/s/prabhave MUNSHI_SITES_DIST=.next-prabhave pnpm build && mv .next-prabhave .next"
    }
  },
  "rewrites": [
    { "source": "/s/elite/(.*)", "destination": { "service": "elite" } },
    { "source": "/s/elite", "destination": { "service": "elite" } },
    { "source": "/s/prabhave/(.*)", "destination": { "service": "prabhave" } },
    { "source": "/s/prabhave", "destination": { "service": "prabhave" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/internal/tick", "schedule": "41 0 * * *" }]
}
