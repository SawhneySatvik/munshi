    "ops.site_request_phone": "on ops.site_request (tenant_id, contact_phone_e164) where erased_at is null",
    "ops.one_hold_per_device": "unique on ops.booking (tenant_id, device_hash) where state = 'held'",
    "ops.booking_shop_state": "on ops.booking (tenant_id, shop_id, state)",
    "ops.booking_ip_held": "on ops.booking (tenant_id, ip_hash) where state = 'held'",
    "ops.booking_held_due": "on ops.booking (tenant_id, expires_at) where state = 'held'",
    "ops.booking_customer": "on ops.booking (tenant_id, customer_id) where customer_id is not null",
    "ops.booking_contact_phone": "on ops.booking_contact (tenant_id, contact_phone_e164) where erased_at is null",
    "ops.reservation_item": "on ops.reservation (tenant_id, item_id, state)",
    "ops.reservation_held_due": "on ops.reservation (tenant_id, held_until) where state = 'held'",
    "ops.reservation_phone": "on ops.reservation (tenant_id, contact_phone_e164) where erased_at is null"
  },
