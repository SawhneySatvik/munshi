{
  "name": "@munshi/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "schema:bootstrap": "node src/bootstrap.ts",
    "schema:build": "node src/build.ts",
    "schema:reset": "node src/reset.ts",
    "reseed": "node seed/reseed.ts",
    "test": "vitest run && vitest run -c vitest.v2.config.ts",
    "redproof": "node test/redproof.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@munshi/core": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "embedded-postgres-17": "npm:embedded-postgres@17.10.0-beta.17"
  }
}
