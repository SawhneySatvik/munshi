# Munshi settings. Copy to .env and fill in; never commit .env.
# Database (dev and tests run on embedded Postgres and need none of these).
DATABASE_URL=
# Hosted deploy only (deploy/supabase.md): the migrator, the one-time admin bootstrap, and the agent's read-only role.
MIGRATOR_DATABASE_URL=
ADMIN_DATABASE_URL=
AGENT_DATABASE_URL=
# Model providers (only the ones an edition uses need a value).
META_MODEL_API_KEY=
BASETEN_API_KEY=
NEBIUS_API_KEY=
GEMINI_API_KEY=
# Anthropic's key (this name, not ANTHROPIC_API_KEY: D-075).
CLAUDE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SARVAM_API_KEY=
MUNSHI_API_URL=
MUNSHI_SITE_KEY_ELITE=
MUNSHI_SITE_KEY_PRABHAVE=
# live | recorded | record
MUNSHI_MODEL_MODE=recorded
# meta | paytm
MUNSHI_EDITION=meta
# The jobs runner's connection (role munshi_jobs; boot refuses any other role, as for every pool).
JOBS_DATABASE_URL=
# The superadmin console's connection (role munshi_platform).
PLATFORM_DATABASE_URL=
# The public API's connection (role munshi_public).
PUBLIC_DATABASE_URL=
# The password identity adapter's connection (role munshi_idp).
IDP_DATABASE_URL=
# demo | live: must equal the database's ops.deployment (no row counts as demo), or boot refuses.
MUNSHI_DEPLOYMENT=
# 32 random bytes as 64 lowercase hex: signs the session cookie.
MUNSHI_SESSION_SECRET=
# Real sign-in's keys, each at least 32 characters (required on live; on demo the sample-shop sign-up's IP limit uses
# the rate key): the email HMAC key and the IP-hash key.
MUNSHI_IDENTITY_SECRET=
MUNSHI_RATE_SECRET=
# The superadmin console's key (32+ characters): seals the operators' TOTP secrets; unset, no operator signs in.
MUNSHI_PLATFORM_SECRET=
# Where the recorded sender writes (ids and body hashes only); empty means a temp folder.
MUNSHI_OUTBOX_DIR=
# Channels (Meta's own). Any deployment may hold them; holding them sends nothing by itself. A real send also needs
# MUNSHI_SEND_MODE=live, a real shop (not a sample) and the superadmin's grant for the channel; else it is recorded.
# WhatsApp Cloud: all four or none, with the phone routes' own HMAC key (32+ characters).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MUNSHI_PHONE_ROUTE_SECRET=
# Approved WhatsApp templates for a send outside the 24-hour window, each optional: its name and, beside it, its exact
# approved body with {{1}} once where the message's words go (both or neither; at most 1024 characters). A purpose
# with none, or words that do not fit (a new line, a tab, a long run of spaces, too long), waits as needs_window.
# The language is the templates' locale (default en).
WHATSAPP_TEMPLATE_CAMPAIGN=
WHATSAPP_TEMPLATE_CAMPAIGN_TEXT=
WHATSAPP_TEMPLATE_CREDIT_DUE=
WHATSAPP_TEMPLATE_CREDIT_DUE_TEXT=
WHATSAPP_TEMPLATE_PACKAGE_EXPIRING=
WHATSAPP_TEMPLATE_PACKAGE_EXPIRING_TEXT=
WHATSAPP_TEMPLATE_PAYPAL_LINK=
WHATSAPP_TEMPLATE_PAYPAL_LINK_TEXT=
WHATSAPP_TEMPLATE_LANGUAGE=
# Instagram (content publishing and its webhook): all five or none. INSTAGRAM_ACCOUNT_REF is the short name the
# superadmin's Instagram grant gives the account (lower case letters, digits, _ . -; no run of seven digits, which a
# platform change refuses), mapped here to the business account id (digits). The app secret signs the webhook (32+
# characters). Do not subscribe the Instagram webhook in Meta's dashboard yet: events are not stored, and the route
# answers them 503.
INSTAGRAM_ACCOUNT_REF=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# graph.instagram.com (an Instagram user token, Instagram Login; the default) or graph.facebook.com (a Page token).
INSTAGRAM_GRAPH_HOST=
# PayPal (sandbox only, D-079): all three or none; none is recorded mode (no PayPal call). PAYPAL_ENV must be sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# The demo shop's tenant id (a uuid) that the demo sign-in lists.
MUNSHI_DEMO_TENANT_ID=
# on | off (empty means on): off turns every model call off for the deployment.
MUNSHI_AI=
# recorded | live (empty means recorded): how outbound messages are sent. Only live wires a real sender.
MUNSHI_SEND_MODE=
# The cache (Redis): redis://[:password@]host:port[/db], unix:///path/to/redis.sock, or off; empty means an in-process
# memory cache. pnpm dev starts redis-server on a socket under .run/ and sets it.
MUNSHI_CACHE_URL=
# The jobs tick's bearer secret (/api/internal/tick); empty admits no one.
CRON_SECRET=
# Set by Vercel on a deployed function (health reports it); leave empty.
VERCEL_REGION=



SUPABASE_URL=
SUPABASE_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
# The app's public origin (https://<host>): where Supabase's email link returns. Required with SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY for a real shop's verified sign-up (deploy/supabase.md §8).
MUNSHI_APP_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

DIRECT_CONNECTION_STRING=
DIRECT_HOST=
DIRECT_PORT=
DIRECT_DATABASE=
DIRECT_USER=

TRANSACTION_POOL_CONNECTION_STRING=
TRANSACTION_POOL_CONNECTION_HOST=
TRANSACTION_POOL_CONNECTION_PORT=
TRANSACTION_POOL_CONNECTION_DATABASE=
TRANSACTION_POOL_CONNECTION_USER=

SESSION_POOL_CONNECTION_STRING=
SESSION_POOL_CONNECTION_HOST=
SESSION_POOL_CONNECTION_PORT=
SESSION_POOL_CONNECTION_DATABASE=
SESSION_POOL_CONNECTION_USER=
