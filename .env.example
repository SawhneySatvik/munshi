# Munshi settings. Copy to .env and fill in; never commit .env.
# Database (dev and tests run on embedded Postgres and need none of these).
DATABASE_URL=
# Hosted deploy only (deploy/neon.md): the migrator, the one-time admin bootstrap, and the agent's read-only role.
MIGRATOR_DATABASE_URL=
ADMIN_DATABASE_URL=
AGENT_DATABASE_URL=
# Model providers (only the ones an edition uses need a value).
META_MODEL_API_KEY=
BASETEN_API_KEY=
NEBIUS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=
# live | recorded | record
MUNSHI_MODEL_MODE=recorded
# meta | paytm
MUNSHI_EDITION=meta
# The jobs runner's connection (role munshi_jobs; boot refuses any other role, as for every pool).
JOBS_DATABASE_URL=
# The superadmin console's connection (role munshi_platform).
PLATFORM_DATABASE_URL=
# The public API's connection (role munshi_public).
PUBLIC_DATABASE_URL=
# The password identity adapter's connection (role munshi_idp).
IDP_DATABASE_URL=
# demo | live: must equal the database's ops.deployment (no row counts as demo), or boot refuses.
MUNSHI_DEPLOYMENT=
# 32 random bytes as 64 lowercase hex: signs the session cookie.
MUNSHI_SESSION_SECRET=
# Real sign-in's keys, each at least 32 characters (required on live; on demo the sample-shop sign-up's IP limit uses
# the rate key): the email HMAC key and the IP-hash key.
MUNSHI_IDENTITY_SECRET=
MUNSHI_RATE_SECRET=
# Where the recorded sender writes (ids and body hashes only); empty means a temp folder.
MUNSHI_OUTBOX_DIR=
# WhatsApp Cloud (live only, after 5 Nov): all four or none, with the phone routes' own HMAC key (32+ characters).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MUNSHI_PHONE_ROUTE_SECRET=
# The demo shop's tenant id (a uuid) that the demo sign-in lists.
MUNSHI_DEMO_TENANT_ID=
# on | off (empty means on): off turns every model call off for the deployment.
MUNSHI_AI=
# recorded | live (empty means recorded): how outbound messages are sent.
MUNSHI_SEND_MODE=
# The jobs tick's bearer secret (/api/internal/tick); empty admits no one.
CRON_SECRET=
# Set by Vercel on a deployed function (health reports it); leave empty.
VERCEL_REGION=
